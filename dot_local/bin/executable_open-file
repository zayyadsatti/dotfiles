#!/bin/bash

# @vicinae.schemaVersion 1
# @vicinae.title __open_file

# open selected file in app
# 1. Open pdf in zathura
# 2. Open excel or presentation files in only-office
# 3. Open other files neovim
# todo: maybe use xdg-mime

selected_file="$(fd . ~ -tf | vicinae dmenu \
    --no-footer \
    --no-metadata \
    --no-section \
    --placeholder 'Open file...')"
[ -z "$selected_file" ] && exit 0

basename="${selected_file##*/}"
extension="${basename##*.}"

pdf_viewer="zathura"
excel_and_powerpoint_viewer="onlyoffice-desktopeditors"
video_file_player="mpv"
audio_file_player="amberol"
fallback_program="neovide"

case "$extension" in
  pdf)
    appropriate_program="$pdf_viewer"
    ;;
  xlsx|pptx|ppsx)
    appropriate_program=$excel_and_powerpoint_viewer
    ;;
  mp4)
    appropriate_program="$video_file_player"
    ;;
  mp3)
    appropriate_program="$audio_file_player"
    ;;
  *)
    appropriate_program="$fallback_program"
    ;;
esac

exec "$appropriate_program" "$selected_file"
