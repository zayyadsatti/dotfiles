[user]
	name = Zayyad
	email = mohammandzayyad@gmail.com
[core]
	editor = nvim
	pager = delta
[init]
	defaultBranch = main
[diff]
	tool = delta
[push]
	autoSetupRemote = true
[credential "https://gitlab.com"]
	helper = 
	helper = !/usr/bin/glab auth git-credential
[alias]
	last = log -1 HEAD
	search = log -i -E --oneline --grep
[grep]
	program = rg
	fallbackToNoIndex = true
[interactive]
	diffFilter = delta --color-only
[merge]
  conflictStyle = zdiff3
[delta]
	navigate = true
  side-by-side = false
  line-numbers = false
	dark = true
  true-color = always
